# PostgreSQL connection string
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Example for local PostgreSQL (default port 5432):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# SEO & Domain Configuration
# The live canonical domain where your site is hosted (e.g. https://zeropanelverse.com)
NEXT_PUBLIC_SITE_URL="https://zeropanelverse.com"

# Google Search Console Site Verification Token
# Obtain this from Google Search Console under 'Ownership verification' -> 'HTML tag'
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

